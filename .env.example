# Local / test (Postgres via docker-compose)
DATABASE_URL=postgresql+psycopg://cocm:cocm_local_dev@localhost:5432/cocm_registry

# Production (Snowflake) — set these via AWS Secrets Manager, never commit real values.
# DATABASE_URL=snowflake://<user>:<password>@<account>/<database>/<schema>?warehouse=<warehouse>&role=<role>

ENVIRONMENT=local

# JWT signing key for Provider authentication (see app/core/security.py).
# A credential exactly like DATABASE_URL above — generate a real random
# value locally (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`)
# and set it via AWS Secrets Manager in production. Never use the app's
# built-in default outside local development.
SECRET_KEY=change-me-to-a-random-value-for-local-dev
